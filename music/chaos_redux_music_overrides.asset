# Chaos Redux Music companion mod.
# Do not redefine vanilla song IDs like maintheme here; duplicate music names
# throw loader errors. The frontend theme is overridden by replacing the
# vanilla file path with music/hoi4mainthemeallies.ogg in this mod.
# If a Chaos Redux super event song ID is redefined here with the same name,
# the old base-mod audio is replaced rather than duplicated.
music = {
	name = "tomorrows_girls"
	file = "hoi4mainthemeallies.ogg"
	volume = 1.00
}
